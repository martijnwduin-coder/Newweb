# ─── Peloton AI configuration ────────────────────────────────────────────────
# Copy to .env.local and fill in. Leave blank to run in demo mode.

# Public site URL (used for share links and Open Graph images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). Both required to switch from demo to live data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps JavaScript API — browser key. RESTRICT it to your domains (HTTP referrers)
# and to the "Maps JavaScript API" in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID (Cloud-based map styling). Required for custom styling of Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Places API (New) — SERVER key, never exposed to the browser.
GOOGLE_PLACES_API_KEY=

# Anthropic API key for the AI discovery assistant (server-side only).
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-opus-5-5
# PELOTON_AI_MODEL=
