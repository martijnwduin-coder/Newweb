# ---------------------------------------------------------------------------
# Nike Deal Tracker — backend configuration (copy to .env; never commit .env)
# ---------------------------------------------------------------------------
ENVIRONMENT=production
# Postgres connection string (Supabase: Project settings -> Database -> URI, use the pooler URL)
DATABASE_URL=postgresql://user:password@host:5432/postgres
POSTGRES_PASSWORD=change-me            # only for docker-compose

# Auth: the first user is created from these on first start (password is hashed)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password
JWT_SECRET=                            # openssl rand -hex 32
CRON_TOKEN=                            # openssl rand -hex 24 (for /internal/* scheduler pings)

# URLs
PUBLIC_APP_URL=https://your-dashboard.vercel.app
CORS_ORIGINS=https://your-dashboard.vercel.app

# Email: resend | smtp | none
EMAIL_PROVIDER=resend
EMAIL_FROM=Nike Deal Tracker <deals@yourdomain.com>
REPORT_RECIPIENT=you@example.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Data collection per country: zalando_web | feed | disabled
CONNECTOR_NL=zalando_web
CONNECTOR_DE=zalando_web
CONNECTOR_FR=zalando_web
CONNECTOR_ES=zalando_web
CONNECTOR_PL=zalando_web
# Authorised affiliate feed URLs (e.g. Awin Create-a-Feed download links), used with CONNECTOR_XX=feed
FEED_URL_NL=
FEED_URL_DE=
FEED_URL_FR=
FEED_URL_ES=
FEED_URL_PL=
FEED_FORMAT=awin

# Crawl budget for zalando_web (per country, per scan)
HTTP_MIN_DELAY_SECONDS=4
ZALANDO_SALE_PAGES=25
ZALANDO_POPULAR_PAGES=4
ZALANDO_INCLUDE_PRIORITY2_SEARCHES=true
MAX_DETAIL_PAGES_PER_COUNTRY=60

# "Run scan now" executor: local (in the API process) | github (workflow_dispatch)
SCAN_EXECUTOR=local
GITHUB_REPOSITORY=owner/repo
GITHUB_TOKEN=                          # fine-grained PAT: Actions read/write on this repo only
GITHUB_REF=main
RUN_INPROCESS_SCHEDULER=false
